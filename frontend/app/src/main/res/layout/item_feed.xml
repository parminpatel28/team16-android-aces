<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    android:elevation="4dp"
    app:cardCornerRadius="8dp"
    tools:context=".ui.home.adapter.FeedAdapter">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp">

        <!-- User Name -->
        <TextView
            android:id="@+id/user_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Username"
            android:textStyle="bold" />

        <!-- Feed Content -->
        <TextView
            android:id="@+id/feed_content"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Review Content"
            android:layout_marginTop="4dp" />

        <!-- Image in Feed -->
        <ImageView
            android:id="@+id/feed_image"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginTop="8dp"
            android:src="@drawable/sample_image"
            android:contentDescription="Feed Image"
            android:layout_gravity="center"/>

        <!-- Like, Comment, and Save Buttons -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <!-- Like Button (Bottom Left) -->
            <ImageButton
                android:id="@+id/like_button"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_heart_orange"
                android:contentDescription="Like Button"
                android:layout_alignParentStart="true"
                android:layout_alignParentBottom="true"
                android:layout_marginEnd="8dp"
                android:background="@android:color/transparent"
                android:scaleType="fitCenter"
                android:adjustViewBounds="true" />

            <!-- Comment Button (Bottom Left) -->
            <ImageButton
                android:id="@+id/comment_button"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_comment_orange"
                android:contentDescription="Comment Button"
                android:layout_toEndOf="@id/like_button"
                android:layout_alignParentBottom="true"
                android:layout_marginEnd="8dp"
                android:background="@android:color/transparent"
                android:scaleType="fitCenter"
                android:adjustViewBounds="true" />

            <!-- Save Button (Bottom Right) -->
            <ImageButton
                android:id="@+id/save_button"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_bookmark_orange"
                android:contentDescription="Save Button"
                android:layout_alignParentEnd="true"
                android:layout_alignParentBottom="true"
                android:background="@android:color/transparent"
                android:scaleType="fitCenter"
                android:adjustViewBounds="true" />

        </RelativeLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>
