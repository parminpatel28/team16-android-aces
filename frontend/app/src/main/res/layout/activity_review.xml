<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    tools:context=".ui.review.ReviewActivity">

    <!-- Toolbar -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fitsSystemWindows="true">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/orange"
            app:titleTextColor="@color/white"
            app:title="@string/leave_review"
            app:navigationIcon="@drawable/arrow_left"
            app:popupTheme="@style/ThemeOverlay.AppCompat.Dark"/>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- Scrollable Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:padding="16dp"
        android:layout_marginTop="?attr/actionBarSize">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Rating Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/overall_rating"
                android:textSize="16sp"
                android:textStyle="bold"/>

            <RatingBar
                android:id="@+id/overallRatingBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:progressTint="@color/yellow"
                android:secondaryProgressTint="@color/yellow"
                android:backgroundTint="@color/gray"
                android:numStars="5"
                android:stepSize="0.5"
                android:rating="0"
                android:isIndicator="false"
                android:clickable="true"
                android:focusable="true"
                android:scaleX="1.25"
                android:scaleY="1.25"
                android:layout_gravity="center_horizontal"
                android:focusableInTouchMode="true"
                android:background="@android:color/transparent"
                android:foreground="@android:color/transparent"
                android:layout_marginTop="8dp"/>

            <!-- Review Caption -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/review_hint"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                app:boxBackgroundMode="outline"
                app:boxStrokeColor="@color/orange"
                app:boxStrokeWidth="2dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/reviewText"
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:padding="12dp"
                    android:textSize="14sp"
                    android:gravity="top|start"/>
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Photo Upload Section -->
            <TextView
                android:id="@+id/tvFileName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="No file selected"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="349dp"
                android:layout_height="113dp"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/selectedImageView"
                    android:layout_width="87dp"
                    android:layout_height="75dp"
                    tools:srcCompat="@tools:sample/avatars" />

                <ImageView
                    android:id="@+id/selectedImageView2"
                    android:layout_width="87dp"
                    android:layout_height="75dp"
                    tools:srcCompat="@tools:sample/avatars" />

                <ImageView
                    android:id="@+id/selectedImageView3"
                    android:layout_width="87dp"
                    android:layout_height="75dp"
                    tools:srcCompat="@tools:sample/avatars" />

            </LinearLayout>

            <Button
                android:id="@+id/btnChooseFile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:backgroundTint="@color/orange"
                android:padding="12dp"
                android:text="Choose File"
                android:textAllCaps="false"
                android:textColor="@color/white" />

            <Button
                android:id="@+id/btnChooseLocation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:backgroundTint="@color/orange"
                android:padding="12dp"
                android:text="Choose Location"
                android:textAllCaps="false"
                android:textColor="@color/white" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/photoUploadLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="@string/add_photos"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                app:boxStrokeWidth="2dp"
                app:boxStrokeColor="@color/gray"/>

            <!-- Tag Restaurant -->
            <com.google.android.material.chip.ChipGroup
                android:id="@+id/tagRestaurantChipGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:singleLine="false"
                app:chipSpacing="8dp"/>


            <!-- TODO: Select Location -->
            <!--            <com.google.android.material.textfield.TextInputLayout-->
            <!--                android:id="@+id/selectLocationLayout"-->
            <!--                android:layout_width="match_parent"-->
            <!--                android:layout_height="wrap_content"-->
            <!--                android:layout_marginTop="16dp"-->
            <!--                android:hint="Select Location">-->

            <!--                <AutoCompleteTextView-->
            <!--                    android:id="@+id/selectLocationDropdown"-->
            <!--                    android:layout_width="match_parent"-->
            <!--                    android:layout_height="wrap_content"-->
            <!--                    android:paddingVertical="12dp"-->
            <!--                    android:minHeight="48dp"-->
            <!--                    android:inputType="text"/>-->
            <!--            </com.google.android.material.textfield.TextInputLayout>-->

            <!-- Submit Button -->
            <Button
                android:id="@+id/submitReviewButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/submit_review"
                android:backgroundTint="@color/orange"
                android:textColor="@color/white"
                android:padding="12dp"
                android:textAllCaps="false"
                android:layout_marginTop="16dp"/>

            <Button
                android:id="@+id/btnUploadFile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Upload File"
                android:backgroundTint="@color/orange"
                android:textColor="@color/white"
                android:padding="12dp"
                android:textAllCaps="false"
                android:layout_marginTop="8dp"
                android:visibility="gone"/>
        </LinearLayout>
    </ScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
