<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- When selected, use the pressed highlight color -->
    <item android:state_selected="true"  >
        <inset android:insetLeft="8dp" android:insetRight="8dp">
            <shape android:shape="rectangle">
                <solid android:color="?android:attr/colorPressedHighlight" />
                <corners android:radius="8dp" />
                <stroke android:width="0.5dp" android:color="@color/gray" />
            </shape>
        </inset>
    </item>



    <!-- Default state (transparent background) -->
    <item android:drawable="@android:color/transparent" />
</selector>